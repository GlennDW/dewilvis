{
  "name": "dewilvis-drinks",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check src/worker.js && node --check public/manage/manage.js && node --check ../app.js",
    "test": "node --test tests/*.test.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy:check": "npm run build && WRANGLER_LOG_PATH=.wrangler/logs/build.log wrangler deploy --dry-run"
  },
  "devDependencies": {
    "miniflare": "5.20261012.1-beta",
    "wrangler": "4.151.1"
  }
}
